{
  "permissions": {
    "allow": [
      "Bash(gh --version)",
      "Bash(gh auth *)",
      "Bash(git fetch *)",
      "Bash(git ls-remote *)",
      "Bash(git -C ~/github/claude-dotfiles *)",
      "Bash(sed 's#refs/heads/##')",
      "Bash(gh run *)",
      "Bash(echo \"EXIT=$?\")",
      "Bash(git ls-tree *)",
      "Bash(gh api *)",
      "Bash(python3 -m json.tool)",
      "Bash(curl -s https://api.github.com/repos/quarto-dev/quarto-cli/releases/latest)",
      "Bash(quarto render *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p ${XDG_CACHE_HOME:-$HOME/.cache}/claude-code && printf working > ${XDG_CACHE_HOME:-$HOME/.cache}/claude-code/status"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p ${XDG_CACHE_HOME:-$HOME/.cache}/claude-code && printf idle > ${XDG_CACHE_HOME:-$HOME/.cache}/claude-code/status"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true,
    "skill-creator@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    }
  },
  "tui": "fullscreen",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  }
}
